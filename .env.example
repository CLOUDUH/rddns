# Default: accessible on deployment machine only.
# For LAN access set your NAS LAN address, e.g. 192.168.1.20.
RDDNS_BIND_IP=127.0.0.1
# Optional, at least 12 characters. Blank generates a password at first startup.
RDDNS_ADMIN_PASSWORD=

# Optional mirror when PyPI is unreachable:
# RDDNS_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
